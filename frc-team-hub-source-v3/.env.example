# Registration invite code. Change this before deploying to a real team server.
TEAM_INVITE_CODE=FRC2026

# Keep true for the local preview. Set false before a real deployment to avoid
# creating the built-in captain demo account and sample work sessions.
SEED_DEMO_DATA=true

# Optional absolute path for SQLite and protected uploads.
# FRC_DATA_DIR=D:\frc-team-hub-data

# Optional cloud vision. Leave empty to keep the scanner in local fallback mode.
# Never prefix this value with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-5.6
