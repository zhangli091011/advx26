# MQTT is server-only. Configure the same account in Mosquitto and hardware.
PIT_MQTT_URL=mqtt://127.0.0.1:1883
PIT_MQTT_USERNAME=pit-device
PIT_MQTT_PASSWORD=change-this-password

# Settings panel persistence. Electron configures this automatically.
# PIT_CONFIG_DIR=/var/lib/pit-os

# Xiaomi Mi Home Smart Plug 3. Bind one or more plugs to CH1-CH8.
# Local IP + token is preferred; did enables cloud fallback.
# Confirm the exact model and property IDs in the Mi Home device/spec data.
# xiaomi.plug.mcn005 example: switch 2/1, active power 3/2.
MIOT_OUTLETS_JSON=[{"id":"CH1","name":"米家智能插座 3","zone":"工作台","model":"xiaomi.plug.mcn005","ip":"192.168.1.31","token":"0123456789abcdef0123456789abcdef","did":"123456789","power":{"siid":2,"piid":1},"watts":{"siid":3,"piid":2}}]
MIOT_POLL_INTERVAL_MS=10000

# Cloud fallback: use a cached session when the account requires 2FA.
MIOT_CLOUD_REGION=cn
# MIOT_CLOUD_USERNAME=
# MIOT_CLOUD_PASSWORD=
# MIOT_CLOUD_SESSION_JSON={"ssecurity":"...","userId":"...","serviceToken":"...","agentId":"...","clientId":"..."}
# MIOT_SESSION_BROKER_URL=https://data.zhangli.online/pit-session
# MIOT_DEBUG=false
