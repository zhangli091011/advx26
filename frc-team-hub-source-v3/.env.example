# Device WebSocket gateway. Use the same token for authorized device clients.
PIT_GATEWAY_URL=ws://127.0.0.1:8765
PIT_GATEWAY_CLIENT_ID=pithub-main
PIT_GATEWAY_TOKEN=replace-with-a-random-64-hex-token

# Settings panel persistence. Electron configures this automatically.
# PIT_CONFIG_DIR=/var/lib/pit-os

# Set before `npm run pi:build`; this value is inlined into the client bundle.
# NEXT_PUBLIC_PIT_DEVICE_PROFILE=pi5

# Add Xiaomi plugs to Home Assistant first, then bind switch/sensor entities to CH1-CH8.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_ACCESS_TOKEN=replace-with-a-long-lived-access-token
# HOME_ASSISTANT_TOKEN remains accepted for existing deployments.
# HOME_ASSISTANT_POLL_INTERVAL_MS is retained for config compatibility; WebSocket updates are push-based.
HOME_ASSISTANT_POLL_INTERVAL_MS=10000
HOME_ASSISTANT_OUTLETS_JSON=[{"id":"CH1","name":"工作台插座","zone":"工作台","switchEntityId":"switch.workbench_plug","wattsEntityId":"sensor.workbench_plug_power"}]

# Must match PIT_TOOL_STATION_ID in /etc/pit-vision-scan.env.
PIT_TOOL_STATION_ID=main

# RTMP camera switcher. MediaMTX control API remains loopback-only.
PIT_MEDIAMTX_API_URL=http://127.0.0.1:9997
PIT_CAMERA_SOURCES_JSON=[{"id":"dabai","label":"Dabai DC"},{"id":"cam2","label":"Camera 2"},{"id":"cam3","label":"Camera 3"},{"id":"cam4","label":"Camera 4"}]

# Official FIRST FRC Events API. Server-only; never use NEXT_PUBLIC_ names.
FRC_API_USERNAME=replace-with-first-api-username
FRC_API_AUTHORIZATION_KEY=replace-with-first-authorization-key
FRC_API_SEASON=2026
# Optional. When blank, PIT-OS selects the active, next, or most recent team event.
FRC_API_EVENT_CODE=
