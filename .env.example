# MQTT is server-only. Configure the same account in Mosquitto and hardware.
PIT_MQTT_URL=mqtt://127.0.0.1:1883
PIT_MQTT_USERNAME=pit-device
PIT_MQTT_PASSWORD=change-this-password

# Settings panel persistence. Electron configures this automatically.
# PIT_CONFIG_DIR=/var/lib/pit-os

# Home Assistant is the only authority for channels listed in these bindings.
# The dashboard path /home/areas-ting_zi is not part of the API base URL.
HOME_ASSISTANT_URL=http://192.168.66.34:8123
HOME_ASSISTANT_MODE=observe
# HOME_ASSISTANT_DEFAULT_AREA_ID=ting_zi

# Prefer a dedicated non-admin Home Assistant user and a long-lived access token.
# When this variable is set, the settings page cannot replace or redirect the token.
# HOME_ASSISTANT_ACCESS_TOKEN=replace-with-a-real-token-outside-version-control

# Optional bootstrap mapping. The settings page can discover and create this JSON.
# HOME_ASSISTANT_BINDINGS_JSON=[{"channelId":"CH1","name":"工作台电源","zone":"亭子","controlEntityId":"switch.workbench","powerEntityId":"sensor.workbench_power","voltageEntityId":"sensor.workbench_voltage","currentEntityId":"sensor.workbench_current"}]
